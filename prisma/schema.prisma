// Base de datos de Check and Point.
//
// Las tablas reflejan los datos que realmente usa la UI (src/lib/properties.ts,
// rates.ts, reservations.ts, y las páginas de gastos/inventario/usuarios).
// Los IDs numéricos (Date.now()) se guardan como BigInt.
// Campos anidados (camas, comodidades, cargos, banco, fotos, descuentos) van en
// columnas Json. `extra` guarda cualquier campo que la UI agregue y que todavía
// no tenga columna propia, para no perder datos.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           BigInt   @id
  userType     String // admin | reservas | propietarios | checkin | huesped | limpieza | mantenimiento
  username     String
  name         String
  lastName     String
  phone        String
  email        String   @unique
  passwordHash String
  enabled      Boolean  @default(true)
  extra        Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([username])
  @@map("users")
}

model Property {
  id          BigInt @id
  category    String
  name        String
  zona        String
  address     String
  number      String
  floor       String
  apartment   String
  description String

  // Detalles
  bedrooms     String
  bathrooms    String
  maxGuests    String
  propertyType String
  ambientes    String

  // Horarios
  checkInFrom  String
  checkInTo    String
  checkOutFrom String
  checkOutTo   String

  beds             Json // Record<bedType, BedConfig>
  amenities        Json // Record<amenityId, boolean>
  mtsDelMar        String
  mascotasCantidad String

  // Cargos
  chargesCurrency String
  charges         Json // { limpieza, servicio, mascotas, cochera, deposito, depositoJoven }

  // WIFI
  wifiNetwork  String
  wifiPassword String

  // Llaves
  keysCount     String
  electronicKey Boolean
  keyCode       String

  // IDs externos (channel manager)
  bookingId String
  airbnbId  String

  bank   Json // cuenta bancaria del propietario
  photos Json // string[]

  enabled   Boolean   @default(true)
  eliminado Boolean   @default(false)
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  updatedAt DateTime  @updatedAt
  extra     Json?

  @@index([eliminado])
  @@map("properties")
}

model Reservation {
  id           BigInt @id
  status       String // CONFIRMADA | PENDIENTE | CANCELADA
  propertyId   String
  propertyName String

  checkInDate  String // YYYY-MM-DD
  checkOutDate String // YYYY-MM-DD
  checkInTime  String
  checkOutTime String
  guests       Int

  // Huésped
  firstName      String
  lastName       String
  phone          String
  docType        String
  dni            String
  hasAttachment  Boolean
  attachmentName String
  dniException   Boolean
  senaException  Boolean

  hasPaymentProof  Boolean
  paymentProofName String
  hasVideo         Boolean
  videoName        String
  videoUrl         String  @default("") // /api/videos/<id> (tabla videos)
  observaciones    String

  // Valor
  currency    String
  channel     String // DIRECTA | BOOKING | AIRBNB
  condition   String
  nights      Int
  valorNoches Float

  mascotasEnabled Boolean
  mascotasQty     Int
  mascotasValue   Float

  cocheraEnabled Boolean
  cocheraId      String
  cocheraValue   Float

  descuento  Float
  totalNeto  Float
  cargos     Float
  totalBruto Float
  senaPct    Float
  senaValue  Float
  restante   Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  extra     Json?

  @@index([propertyId])
  @@index([checkInDate])
  @@map("reservations")
}

// Calendario de tarifas/disponibilidad: una fila por propiedad y día.
model RateEntry {
  propertyId  String
  date        String // YYYY-MM-DD (hora local)
  price       Float
  available   Boolean
  status      String? // abierto | cerrado | cerrado24
  closedUntil String?
  planIds     Json // string[]
  updatedAt   DateTime @updatedAt
  extra       Json?

  @@id([propertyId, date])
  @@map("rate_entries")
}

model RatePlan {
  id                 String   @id
  name               String
  description        String
  color              String?
  hasMinNights       Boolean
  minNights          Int
  hasPerDayNights    Boolean
  perDayNights       Json // Record<weekday, string>
  priceVariation     String
  priceVariationType String // aumento | reduccion
  hasStayDiscount    Boolean
  stayDiscounts      Json // { duration, percent }[]
  proximityDiscounts Json // { days, percent }[]
  weekendSurcharge   String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  extra              Json?

  @@map("rate_plans")
}

model Expense {
  id          BigInt   @id
  description String
  amount      Float
  date        String // YYYY-MM-DD
  category    String
  unit        String // nombre de la propiedad o "General"
  receipt     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  extra       Json?

  @@index([date])
  @@map("expenses")
}

model InventoryItem {
  id            BigInt   @id
  name          String
  category      String
  currentStock  Float
  minStock      Float
  maxStock      Float
  unit          String
  location      String
  cost          Float
  supplier      String?
  lastRestocked String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  extra         Json?

  @@map("inventory_items")
}

// Categorías de cargos (Categorías → Limpieza / Servicio). Los alojamientos eligen una
// categoría (charges.limpiezaCategoryId / servicioCategoryId) y usan siempre su precio
// actual. El precio de mascotas va en app_settings "petCharges" ({ USD, ARS }).
model ChargeCategory {
  id        BigInt   @id
  type      String // limpieza | servicio
  name      String
  zona      String   @default("") // sólo servicio
  amount    Float
  currency  String // USD | ARS
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  extra     Json?

  @@index([type])
  @@map("charge_categories")
}

// Configuración (settings de usuario, canales, secreto de auth, etc.)
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// Fotos (de propiedades y cocheras). Se guardan los bytes en la base, ya comprimidos;
// la propiedad guarda sólo la URL /api/photos/<id>.
model Photo {
  id         String   @id // aleatorio, no adivinable
  propertyId String? // null mientras no se guardó la propiedad (se limpia a las 24h)
  mimeType   String
  size       Int
  width      Int?
  height     Int?
  data       Bytes
  createdAt  DateTime @default(now())

  @@index([propertyId])
  @@map("photos")
}

// Videos de reservas. La fila guarda los datos del video; el archivo (pesado, se sirve
// por partes para poder adelantarlo) va en storage/videos/<id>. La reserva guarda la
// URL /api/videos/<id>.
model Video {
  id            String   @id // aleatorio, no adivinable
  reservationId String? // null mientras no se guardó la reserva (se limpia a las 24h)
  fileName      String
  mimeType      String
  size          Int
  createdAt     DateTime @default(now())

  @@index([reservationId])
  @@map("videos")
}
